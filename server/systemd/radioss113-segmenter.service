[Unit]
Description=Radio SS113 - Icecast Auto-Discovery Segmenter (UTC hourly)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=radio
Group=radio
WorkingDirectory=/home/radio/segmenter
ExecStart=/usr/bin/python3 -u /home/radio/segmenter/segmenter.py --status-url http://127.0.0.1:8001/status-json.xsl --reconnect-wait 5
Restart=always
RestartSec=5
Nice=5
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
